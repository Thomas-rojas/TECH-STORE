# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173,https://lambent-liger-1112cc.netlify.app

# ─── Supabase ─────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the service_role key ONLY on the backend (never in the frontend)
SUPABASE_SERVICE_ROLE_KEY=
# Optional: anon key if you later expose limited public reads
SUPABASE_ANON_KEY=

# ─── Auth JWT (API propia) ────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── App URLs ─────────────────────────────────────────────
APP_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ─── Mercado Pago ─────────────────────────────────────────
# TODO: pegar Access Token y Public Key
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_MODE=sandbox

# ─── Addi ─────────────────────────────────────────────────
# TODO: pegar credenciales Addi
ADDI_API_KEY=
ADDI_API_SECRET=
ADDI_MERCHANT_ID=
ADDI_WEBHOOK_SECRET=
ADDI_BASE_URL=https://api.addi.com
ADDI_MODE=sandbox

# ─── Bold ─────────────────────────────────────────────────
# TODO: pegar credenciales Bold
BOLD_API_KEY=
BOLD_SECRET_KEY=
BOLD_WEBHOOK_SECRET=
BOLD_BASE_URL=https://integrations.api.bold.co
BOLD_MODE=sandbox

# ─── Seed admin ───────────────────────────────────────────
SEED_ADMIN_IDENTIFICATION=admin
SEED_ADMIN_PASSWORD=importcas
SEED_ADMIN_EMAIL=admin@importcas.com
